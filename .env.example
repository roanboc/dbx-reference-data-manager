# Local development settings (copy to .env). Never commit .env.
RDM_BACKEND=duckdb                 # duckdb | databricks
RDM_DUCKDB_PATH=data/rdm.duckdb    # local database file
RDM_AUTH=mock                      # mock | databricks
RDM_PERSONA=admin                  # default persona for mock auth: admin | function_admin | editor | viewer
RDM_CATALOG=_reference_data                 # Unity Catalog catalog name (production)
RDM_MAX_ROWS=5000                  # rows loaded into the grid per form
RDM_MAX_FILE_MB=200                # largest CSV/Parquet file accepted through the browser upload
RDM_ADMIN_CONTACT=                 # e-mail, URL or text shown in Help > About ("talk to ..."); optional

# Production (Databricks App) - DATABRICKS_HOST is set by the runtime, DATABRICKS_WAREHOUSE_ID by app.yaml
# DATABRICKS_HOST=
# DATABRICKS_WAREHOUSE_ID=
RDM_METADATA_CACHE_TTL=0            # seconds to cache navigation/permissions per user (300 in Databricks)
RDM_WORKERS=2                      # gunicorn workers in production (forced to 1 for DuckDB)
